<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ee4j</groupId>
        <artifactId>project</artifactId>
        <version>2.0.2</version>
        <relativePath/>
    </parent>

    <groupId>jakarta.crac</groupId>
    <artifactId>jakarta.crac-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Jakarta CRaC Parent</name>
    <description>Parent build for Jakarta CRaC modules.</description>
    <url>https://github.com/jakartaee/crac</url>

    <modules>
        <module>api</module>
        <module>spec</module>
    </modules>

    <licenses>
        <license>
            <name>Eclipse Public License 2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/jakartaee/crac.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/jakartaee/crac.git</developerConnection>
        <url>https://github.com/jakartaee/crac</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/jakartaee/crac/issues</url>
    </issueManagement>

    <developers>
        <developer>
            <name>Jakarta CRaC Developers</name>
            <email>crac-dev@eclipse.org</email>
            <organization>Eclipse Foundation</organization>
            <organizationUrl>https://www.eclipse.org</organizationUrl>
        </developer>
    </developers>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <jakarta.ee.version>11.0.0</jakarta.ee.version>
        <cyclonedx.skip>true</cyclonedx.skip>
        <spec.version>1.0</spec.version>
        <!-- Draft | Final Release -->
        <spec.status>Draft</spec.status>
        <nexus.staging.repository>crac-maven2-staging</nexus.staging.repository>
        <project.build.outputTimestamp>2026-11-24T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakarta.ee.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <locale>en</locale>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-se-baseline</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Jakarta CRaC requires Java SE 21 or newer.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>2.103.0</version>
                        </palantirJavaFormat>
                        <importOrder>
                            <order>,javax|java,\#</order>
                        </importOrder>
                        <removeUnusedImports/>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>**/*.md</include>
                                <include>**/*.adoc</include>
                                <include>**/*.asciidoc</include>
                                <include>**/*.xml</include>
                                <include>**/*.properties</include>
                                <include>**/*.sh</include>
                                <include>**/Jenkinsfile</include>
                                <include>.github/**/*.yml</include>
                            </includes>
                            <excludes>
                                <exclude>**/target/**</exclude>
                            </excludes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
